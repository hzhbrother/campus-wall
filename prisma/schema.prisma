// 校园墙 Prisma schema
// 数据库: PostgreSQL (Supabase / Neon / 自建均可)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // db push / migrate 需要直连; Supabase 填 Session pooler (5432) 连接串
  directUrl = env("DIRECT_URL")
}

// ---- 枚举 ----

enum UserRole {
  USER        // 兼容旧数据
  STUDENT     // 学生
  TEACHER     // 教师
  ADMIN       // 管理员 (校内运营)
  SUPER_ADMIN // 超级管理员
}

enum UserStatus {
  NORMAL     // 正常访问
  GRADUATED  // 毕业生
  BANNED     // 封禁
}

enum AccountProvider {
  LOCAL
  GITHUB
  GOOGLE
  WECHAT
  QQ
  WEIBO
  HUAWEI
  ALIPAY
  BAIDU
  DOUYIN
}

enum PostStatus {
  PENDING   // 待审核
  APPROVED  // 已通过
  REJECTED  // 已驳回
}

enum OrderType {
  PIN     // 帖子置顶推广
  REWARD  // 打赏作者
  VIP     // 会员订阅
}

enum OrderStatus {
  PENDING // 待支付
  PAID    // 已支付
  FAILED  // 失败
  REFUNDED // 已退款
}

enum NotificationType {
  SYSTEM   // 系统通知
  POST     // 帖子相关 (审核结果等)
  COMMENT  // 评论回复
  LIKE     // 点赞
  ANNOUNCE // 公告
  BAN      // 封禁通知
}

enum AppealStatus {
  PENDING   // 待处理
  APPROVED  // 申诉通过(已解封)
  REJECTED  // 申诉驳回
}

enum ViolationType {
  SPAM        // 垃圾广告
  ABUSE       // 辱骂攻击
  PORN        // 色情低俗
  ILLEGAL     // 违法违规
  PLAGIARISM  // 抄袭侵权
  OTHER       // 其他
}

enum VerificationStatus {
  NONE         // 未提交
  AI_REVIEWING // AI 初审中 (判断是否校园卡、是否清晰)
  PENDING      // AI 初审通过, 等待人工复审
  APPROVED     // 已通过
  REJECTED     // 已驳回 (AI 初审驳回 或 人工驳回)
}

// 认证模板类型: 学生认证(校园卡) / 老师认证(工作证) / 资质认证(学生会/广播站等岗位证明)
enum VerificationTemplateType {
  STUDENT
  TEACHER
  QUALIFICATION
}

enum NotificationTarget {
  ALL      // 全体用户
  ROLE     // 按角色
  USERS    // 指定用户
}

// ---- 模型 ----

model User {
  id           String           @id @default(cuid())
  email        String?          @unique // OAuth-only 用户可为空
  password     String?          // 本地密码 hash, OAuth 用户为空
  nickname     String
  realName     String?          // 真实姓名
  avatar       String?
  coverImage   String?          // 个人主页封面图
  // 头像审核流程: 上传 -> pendingAvatar(待审核) -> AI 初筛 -> 人工复审 -> avatar(正式)
  pendingAvatar       String?             // 待审核头像 (base64), 审核通过后移到 avatar
  avatarStatus         VerificationStatus @default(NONE)  // 头像审核状态: PENDING/APPROVED/REJECTED/NONE
  avatarRejectReason   String?             // 头像驳回原因
  avatarReviewedAt     DateTime?           // 头像审核完成时间
  studentId    String?          // 学号 (可选实名)
  countryCode  String?          // 手机区号, 如 +86 / +852
  phoneNumber  String?          // 手机号 (不含区号)
  grade        String?          // 年级
  className    String?          // 班级
  remark       String?          // 备注
  role         UserRole         @default(STUDENT) // 系统内置角色 (快速判断用)
  roleId       String?          // 自定义角色 ID (优先于 role 字段的权限)
  status       UserStatus       @default(NORMAL)
  bannedUntil  DateTime?        // 封禁到期时间 (null=未临时封禁)
  banReason    String?          // 封禁原因
  credibilityScore Int          @default(100) // 诚信分 (0-100)
  verified      Boolean        @default(false) // 是否已认证 (实名/学生认证)
  verifiedAt    DateTime?      // 认证通过时间
  verificationPhoto String?    // 认证照片 (base64, 卡面或人脸)
  verificationPhotoType String? // 照片类型: CARD(卡面) / FACE(人脸)
  verificationTemplateId String? // 用户认证时选择的学校模板 ID
  verificationTemplate   VerificationTemplate? @relation(fields: [verificationTemplateId], references: [id])
  verificationStatus VerificationStatus @default(NONE) // 认证审核状态
  verificationRejectReason String? // 驳回原因
  verificationAiResult Json?  // AI 初审识别结果 (信息+边界框), 供人工复核参考
  verificationReviewedBy String? // 人工复核人 ID
  verificationReviewedAt DateTime? // 人工复核时间
  // 资质认证 (学生会/广播站等组织认证)
  qualificationType String?    // 组织类型: 学生会/广播站/团委/社团等
  qualificationVerified Boolean @default(false) // 资质认证是否已通过
  qualificationVerifiedAt DateTime? // 资质认证通过时间
  qualificationPhoto String? // 资质认证证明材料照片
  qualificationStatus VerificationStatus @default(NONE) // 资质认证审核状态
  qualificationRejectReason String? // 资质认证驳回原因
  aiImageCheck Json? // AI 图片真实性检测结果 (身份认证照片)
  lastReadNotificationsAt DateTime? // 上次标记全部已读的时间 (用于广播通知未读计算)
  points Int @default(0) // 积分 (签到等获得)
  // 隐私开关 (默认公开)
  followsPublic    Boolean @default(true) // 我的关注列表是否对外公开
  fansPublic       Boolean @default(true) // 我的粉丝列表是否对外公开
  badgesPublic     Boolean @default(true) // 我的勋章是否在主页对外展示
  honorsPublic     Boolean @default(true) // 我的荣誉证书是否在主页对外展示
  favoritesPublic  Boolean @default(true) // 我的收藏数是否在主页对外展示
  likesPublic      Boolean @default(true) // 我的获赞数是否在主页对外展示
  userNumber Int? // 用户编号 (顺序号, 用于生成 XYS/XY 编号)
  schoolId     String?          // 所属学校
  organizationId String?        // 所属团体
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  accounts     Account[]
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  orders       Order[]
  auditLogs    AuditLog[]
  banRecords   BanRecord[]
  appeals      BanAppeal[]
  violations   ViolationRecord[]
  notifications Notification[]
  notificationSettings NotificationSetting?
  customRole   Role?            @relation(fields: [roleId], references: [id])
  userBadges   UserBadge[]
  qualifications Qualification[]
  qualificationComments QualificationComment[]
  qualificationLikes QualificationLike[]
  checkIns     CheckInRecord[]
  pointsLogs   PointsLog[]  @relation("PointsLogUser")
  pointsLogsAsAdmin PointsLog[] @relation("PointsLogAdmin")
  wishItems    WishItem[]
  exchanges    ExchangeRecord[]
  school       School?          @relation(fields: [schoolId], references: [id])
  organization Organization?    @relation(fields: [organizationId], references: [id])
  follows      Follow[]         @relation("FollowerUser") // 我关注了谁
  followers    Follow[]         @relation("FollowedUser") // 谁关注了我

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([roleId])
  @@index([schoolId])
  @@index([organizationId])
}

// ---- 角色 (支持超级管理员自定义角色名称与权限) ----

model Role {
  id          String   @id @default(cuid())
  code        String   @unique  // 系统角色: SUPER_ADMIN/ADMIN/TEACHER/STUDENT/USER; 自定义: CUSTOM_xxx
  name        String            // 显示名称 (可被超级管理员修改)
  permissions Json     @default("[]") // 权限码数组, 如 ["user.view", "post.moderate"]
  isSystem    Boolean  @default(false) // 系统内置角色不可删除
  isDefault   Boolean  @default(false) // 新注册用户的默认角色 (仅 STUDENT 一个)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

// ---- 实名认证识别模板 (超级管理员上传样图并框选需识别的字段) ----
model VerificationTemplate {
  id        String   @id @default(cuid())
  name      String            // 模板名称, 如 "一中校园卡"
  type      VerificationTemplateType @default(STUDENT) // 学生认证 / 老师认证
  image     String            // 样图 base64
  fields    Json     @default("[]") // [{ name: "姓名", bbox: {x,y,w,h} }] 归一化坐标
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

// 第三方账号绑定 (一个用户可绑定多个平台)
model Account {
  id             String           @id @default(cuid())
  userId         String
  provider       AccountProvider
  providerUid    String           // 第三方用户唯一ID
  rawProfile      Json?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

model Post {
  id           String       @id @default(cuid())
  authorId     String
  title        String
  content      String
  category     String       @default("校园") // 校园/失物/二手/表白/招聘 等
  images       String[]     @default([])
  isAnonymous  Boolean      @default(false)
  status       PostStatus   @default(PENDING)
  pinned       Boolean      @default(false)
  viewCount    Int          @default(0)
  likeCount    Int          @default(0)
  commentCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  orders       Order[]      // 关联的置顶/打赏订单

  @@index([authorId])
  @@index([status, createdAt])
  @@index([category])
}

model Comment {
  id         String    @id @default(cuid())
  postId     String
  authorId   String
  content    String
  parentId   String?    // 支持楼中楼回复
  createdAt  DateTime  @default(now())

  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReply", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[] @relation("CommentReply")

  @@index([postId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  postId          String?
  type            OrderType
  amount          Int          // 单位: 分
  currency        String       @default("CNY")
  status          OrderStatus @default(PENDING)
  provider        String       @default("mock")
  providerOrderNo String?
  subject         String
  createdAt       DateTime     @default(now())
  paidAt          DateTime?

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post            Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([providerOrderNo])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   // APPROVE_POST / BAN_USER / SET_ROLE ...
  target    String
  detail    String?
  createdAt DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
}

// ---- 通知系统 ----

model Notification {
  id        String           @id @default(cuid())
  userId    String?          // null = 广播通知 (ALL)
  type      NotificationType @default(SYSTEM)
  title     String
  content   String
  isRead    Boolean          @default(false)
  pinned    Boolean          @default(false)  // 强调/置顶通知
  link      String?          // 跳转链接
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// 用户通知偏好设置
model NotificationSetting {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailNotify     Boolean @default(true)   // 邮件通知
  systemNotify    Boolean @default(true)   // 系统站内通知
  commentNotify   Boolean @default(true)   // 评论通知
  likeNotify      Boolean @default(true)   // 点赞通知
  updatedAt       DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- 收藏 ----

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

// ---- 封禁记录 ----

model BanRecord {
  id           String    @id @default(cuid())
  userId       String
  reason       String    // 封禁原因
  durationDays Int       // 封禁天数 (0=永久)
  durationHours Int      @default(0) // 封禁小时数 (0-23)
  bannedUntil  DateTime? // 封禁到期时间 (永久封禁为 null)
  isPermanent  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  liftedAt     DateTime? // 解封时间
  liftedReason  String?  // 解封原因

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals      BanAppeal[]

  @@index([userId, createdAt])
}

// ---- 封禁申诉 ----

model BanAppeal {
  id           String       @id @default(cuid())
  userId       String
  banRecordId  String
  reason       String       // 申诉原因
  content      String       // 申诉内容
  images       String[]     @default([]) // 申诉图片 (压缩后 base64)
  status       AppealStatus @default(PENDING)
  reviewerNote String?      // 审核备注
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  banRecord    BanRecord    @relation(fields: [banRecordId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- 违规记录 (用于诚信分) ----

model ViolationRecord {
  id             String        @id @default(cuid())
  userId         String
  type           String        @default("SPAM")  // 违规类型, 支持自定义
  reason         String        // 违规原因描述
  pointsDeducted Int           // 扣除的诚信分
  relatedPostId  String?       // 关联帖子
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- 邮件验证码 (用于忘记密码、绑定邮箱等) ----

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6 位验证码
  purpose   String   // 用途: reset-password / bind-email / change-email
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt])
}

// ---- 邮件模板 (管理员可自定义邮件内容) ----

model EmailTemplate {
  key       String   @id        // 模板唯一键, 如 verification-code / notification
  name      String              // 模板名称
  subject   String              // 邮件主题 (支持变量)
  html      String              // 邮件 HTML 内容 (支持变量)
  updatedAt DateTime @updatedAt
}

// ---- 站点配置 (键值对存储, 含 SMTP 等) ----

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---- 勋章系统 ----

model Badge {
  id          String   @id @default(cuid())
  name        String            // 徽章/勋章名称, 如 "发帖达人"
  description String?           // 徽章/勋章描述
  icon        String?           // 图标 (emoji 或 base64, 兼容旧数据)
  imageUrl    String?           // 自定义徽章图片 URL (透明背景 PNG 优先, 设置后优先于 icon)
  // 获得条件: type=POST_COUNT 发帖数达到 threshold; type=LIKE_COUNT 获赞数; type=COMMENT_COUNT 评论数; type=CHECKIN_DAYS 连续签到天数; type=POINTS 积分达到
  conditionType String         // POST_COUNT | LIKE_COUNT | COMMENT_COUNT | CHECKIN_DAYS | POINTS | MANUAL
  threshold   Int      @default(1) // 条件阈值
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now()) // 获得时间 (用于显示年份)
  claimedAt DateTime? // 领取时间 (null 表示待领取, 由用户主动点击领取)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ---- 关注系统 ----

model Follow {
  id          String   @id @default(cuid())
  followerId  String                     // 关注者
  followingId String                    // 被关注者
  createdAt   DateTime @default(now())

  follower    User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ---- 资质/荣誉认证 (一个用户可拥有多个, 需管理员审核) ----

model Qualification {
  id              String             @id @default(cuid())
  userId          String
  type            String                          // 资质/荣誉名称, 如 "学生会主席" / "优秀志愿者"
  category        String             @default("QUALIFICATION") // QUALIFICATION(资质) / HONOR(荣誉)
  photo           String?                         // 证明材料 (证书/奖状 base64) — 正面
  photo2          String?                         // 证明材料第二张 (卡面反面/证书内页 base64)
  displayPhoto    String?                         // 公开展示哪一面: "photo" | "photo2" (管理员审核时选择)
  status          VerificationStatus @default(NONE)
  verified        Boolean            @default(false)
  verifiedAt      DateTime?
  rejectReason    String?
  aiImageCheck    Json?                             // AI 图片真实性检测结果
  // 详情页可见性: PUBLIC(公开) / FOLLOWERS(仅粉丝可见) / PRIVATE(不公开, 仅自己)
  visibility      String             @default("PUBLIC")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments        QualificationComment[]
  likes           QualificationLike[]

  @@index([userId])
  @@index([status])
}

// 奖状/资质详情页评论 (独立于帖子评论, 避免动 Post 关系)
model QualificationComment {
  id              String    @id @default(cuid())
  qualificationId String
  authorId        String
  content         String
  parentId        String?    // 楼中楼回复
  createdAt       DateTime  @default(now())

  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent          QualificationComment? @relation("QualCommentReply", fields: [parentId], references: [id], onDelete: SetNull)
  replies         QualificationComment[] @relation("QualCommentReply")

  @@index([qualificationId, createdAt])
  @@index([authorId])
}

// 奖状/资质点赞
model QualificationLike {
  id              String    @id @default(cuid())
  qualificationId String
  userId          String
  createdAt       DateTime  @default(now())

  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([qualificationId, userId])
  @@index([qualificationId])
  @@index([userId])
}

// ---- 签到记录 (积分) ----

model CheckInRecord {
  id        String   @id @default(cuid())
  userId    String
  date      String            // 日期 YYYY-MM-DD (便于去重查询)
  points    Int      @default(1) // 本次获得积分
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ---- 积分流水 (管理员赠与/扣除) ----

model PointsLog {
  id          String   @id @default(cuid())
  userId      String
  adminId     String              // 操作管理员 ID
  amount      Int                 // 变动积分 (正=增加, 负=扣除)
  balanceAfter Int                // 变动后余额
  reason      String?             // 备注原因
  createdAt   DateTime @default(now())

  user        User     @relation("PointsLogUser", fields: [userId], references: [id], onDelete: Cascade)
  admin       User     @relation("PointsLogAdmin", fields: [adminId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ---- 学校 ----

model School {
  id          String   @id @default(cuid())
  name        String            // 学校名称
  stage       String?           // 学段: 幼儿园/小学/初中/高中/大学/其他
  description String?           // 学校简介
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@index([name])
}

// ---- 许愿单 (积分商城许愿) ----

model WishItem {
  id          String   @id @default(cuid())
  userId      String
  itemName    String             // 想兑换的物品名称
  description String             // 物品/事件描述
  image       String?            // 图片 (base64 或 URL)
  status      String   @default("PENDING") // PENDING(待查看) | REVIEWED(已查看) | ADOPTED(已采纳)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ---- 快捷通道 ----

model QuickLink {
  id          String   @id @default(cuid())
  title       String                         // 显示名称
  url         String                         // 跳转链接
  icon        String?                         // 图标 (base64 图片 或 URL)
  sortOrder   Int      @default(0)            // 排序 (小的在前)
  clickCount  Int      @default(0)            // 点击人次
  isActive    Boolean  @default(true)         // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- 积分商城商品 ----

model ShopItem {
  id          String   @id @default(cuid())
  name        String                         // 商品名称
  description String?                         // 商品描述
  image       String?                         // 商品图片 (base64 或 URL)
  pointsCost  Int                              // 兑换所需积分
  stock       Int      @default(-1)            // 库存 (-1 = 不限)
  isActive    Boolean  @default(true)          // 是否上架
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exchanges   ExchangeRecord[]
}

// ---- 积分兑换记录 ----

model ExchangeRecord {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  pointsCost  Int                              // 兑换时花费的积分
  status      String   @default("PENDING")     // PENDING(待发放) | FULFILLED(已发放) | CANCELLED(已取消)
  createdAt   DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        ShopItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemId])
}

// ---- 团体 (非学校组织, 如社团/救援队/志愿者团队等) ----

model Organization {
  id          String   @id @default(cuid())
  name        String            // 团体名称
  description String?           // 团体简介
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@index([name])
}
