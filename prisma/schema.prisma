// 校园墙 Prisma schema
// 数据库: PostgreSQL (Neon / 自建均可)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ---- 枚举 ----

enum UserRole {
  USER        // 兼容旧数据
  STUDENT     // 学生
  TEACHER     // 教师
  ADMIN       // 管理员 (校内运营)
  SUPER_ADMIN // 超级管理员
}

enum UserStatus {
  NORMAL     // 正常访问
  GRADUATED  // 毕业生
  BANNED     // 封禁
}

enum AccountProvider {
  LOCAL
  GITHUB
  GOOGLE
  WECHAT
  QQ
  WEIBO
  HUAWEI
  ALIPAY
  BAIDU
  DOUYIN
}

enum PostStatus {
  PENDING   // 待审核
  APPROVED  // 已通过
  REJECTED  // 已驳回
}

enum OrderType {
  PIN     // 帖子置顶推广
  REWARD  // 打赏作者
  VIP     // 会员订阅
}

enum OrderStatus {
  PENDING // 待支付
  PAID    // 已支付
  FAILED  // 失败
  REFUNDED // 已退款
}

enum NotificationType {
  SYSTEM   // 系统通知
  POST     // 帖子相关 (审核结果等)
  COMMENT  // 评论回复
  LIKE     // 点赞
  ANNOUNCE // 公告
  BAN      // 封禁通知
}

enum AppealStatus {
  PENDING   // 待处理
  APPROVED  // 申诉通过(已解封)
  REJECTED  // 申诉驳回
}

enum ViolationType {
  SPAM        // 垃圾广告
  ABUSE       // 辱骂攻击
  PORN        // 色情低俗
  ILLEGAL     // 违法违规
  PLAGIARISM  // 抄袭侵权
  OTHER       // 其他
}

enum NotificationTarget {
  ALL      // 全体用户
  ROLE     // 按角色
  USERS    // 指定用户
}

// ---- 模型 ----

model User {
  id           String           @id @default(cuid())
  email        String?          @unique // OAuth-only 用户可为空
  password     String?          // 本地密码 hash, OAuth 用户为空
  nickname     String
  realName     String?          // 真实姓名
  avatar       String?
  coverImage   String?          // 个人主页封面图
  studentId    String?          // 学号 (可选实名)
  countryCode  String?          // 手机区号, 如 +86 / +852
  phoneNumber  String?          // 手机号 (不含区号)
  grade        String?          // 年级
  className    String?          // 班级
  remark       String?          // 备注
  role         UserRole         @default(STUDENT)
  status       UserStatus       @default(NORMAL)
  bannedUntil  DateTime?        // 封禁到期时间 (null=未临时封禁)
  banReason    String?          // 封禁原因
  credibilityScore Int          @default(100) // 诚信分 (0-100)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  accounts     Account[]
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  orders       Order[]
  auditLogs    AuditLog[]
  banRecords   BanRecord[]
  appeals      BanAppeal[]
  violations   ViolationRecord[]
  notifications Notification[]
  notificationSettings NotificationSetting?

  @@index([email])
  @@index([role])
  @@index([status])
}

// 第三方账号绑定 (一个用户可绑定多个平台)
model Account {
  id             String           @id @default(cuid())
  userId         String
  provider       AccountProvider
  providerUid    String           // 第三方用户唯一ID
  rawProfile      Json?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

model Post {
  id           String       @id @default(cuid())
  authorId     String
  title        String
  content      String
  category     String       @default("校园") // 校园/失物/二手/表白/招聘 等
  images       String[]     @default([])
  isAnonymous  Boolean      @default(false)
  status       PostStatus   @default(PENDING)
  pinned       Boolean      @default(false)
  viewCount    Int          @default(0)
  likeCount    Int          @default(0)
  commentCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  orders       Order[]      // 关联的置顶/打赏订单

  @@index([authorId])
  @@index([status, createdAt])
  @@index([category])
}

model Comment {
  id         String    @id @default(cuid())
  postId     String
  authorId   String
  content    String
  parentId   String?    // 支持楼中楼回复
  createdAt  DateTime  @default(now())

  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReply", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[] @relation("CommentReply")

  @@index([postId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  postId          String?
  type            OrderType
  amount          Int          // 单位: 分
  currency        String       @default("CNY")
  status          OrderStatus @default(PENDING)
  provider        String       @default("mock")
  providerOrderNo String?
  subject         String
  createdAt       DateTime     @default(now())
  paidAt          DateTime?

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post            Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([providerOrderNo])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   // APPROVE_POST / BAN_USER / SET_ROLE ...
  target    String
  detail    String?
  createdAt DateTime @default(now())

  actor     User     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
}

// ---- 通知系统 ----

model Notification {
  id        String           @id @default(cuid())
  userId    String?          // null = 广播通知 (ALL)
  type      NotificationType @default(SYSTEM)
  title     String
  content   String
  isRead    Boolean          @default(false)
  pinned    Boolean          @default(false)  // 强调/置顶通知
  link      String?          // 跳转链接
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// 用户通知偏好设置
model NotificationSetting {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailNotify     Boolean @default(true)   // 邮件通知
  systemNotify    Boolean @default(true)   // 系统站内通知
  commentNotify   Boolean @default(true)   // 评论通知
  likeNotify      Boolean @default(true)   // 点赞通知
  updatedAt       DateTime @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- 收藏 ----

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

// ---- 封禁记录 ----

model BanRecord {
  id           String    @id @default(cuid())
  userId       String
  reason       String    // 封禁原因
  durationDays Int       // 封禁天数 (0=永久)
  durationHours Int      @default(0) // 封禁小时数 (0-23)
  bannedUntil  DateTime? // 封禁到期时间 (永久封禁为 null)
  isPermanent  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  liftedAt     DateTime? // 解封时间
  liftedReason  String?  // 解封原因

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals      BanAppeal[]

  @@index([userId, createdAt])
}

// ---- 封禁申诉 ----

model BanAppeal {
  id           String       @id @default(cuid())
  userId       String
  banRecordId  String
  reason       String       // 申诉原因
  content      String       // 申诉内容
  images       String[]     @default([]) // 申诉图片 (压缩后 base64)
  status       AppealStatus @default(PENDING)
  reviewerNote String?      // 审核备注
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  banRecord    BanRecord    @relation(fields: [banRecordId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- 违规记录 (用于诚信分) ----

model ViolationRecord {
  id             String        @id @default(cuid())
  userId         String
  type           String        @default("SPAM")  // 违规类型, 支持自定义
  reason         String        // 违规原因描述
  pointsDeducted Int           // 扣除的诚信分
  relatedPostId  String?       // 关联帖子
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- 邮件验证码 (用于忘记密码、绑定邮箱等) ----

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6 位验证码
  purpose   String   // 用途: reset-password / bind-email / change-email
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt])
}

// ---- 邮件模板 (管理员可自定义邮件内容) ----

model EmailTemplate {
  key       String   @id        // 模板唯一键, 如 verification-code / notification
  name      String              // 模板名称
  subject   String              // 邮件主题 (支持变量)
  html      String              // 邮件 HTML 内容 (支持变量)
  updatedAt DateTime @updatedAt
}

// ---- 站点配置 (键值对存储, 含 SMTP 等) ----

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
