# =====================================================================
# 校园墙环境变量示例
# 本地开发: 复制为 .env.local
# Vercel 部署: 在 Vercel 项目 Settings → Environment Variables 逐个填入
# =====================================================================

# ---------- 数据库 (Neon PostgreSQL, 必填) ----------
# Neon 控制台获取: https://neon.tech  (免费 serverless PG)
# 形如: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# ---------- JWT (必填) ----------
# 任意长随机字符串, 建议 32+ 字符
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---------- 种子数据 (首次 db:seed 创建超级管理员) ----------
SEED_SUPER_ADMIN_EMAIL="admin@campus.edu"
SEED_SUPER_ADMIN_PASSWORD="Admin@12345"

# ---------- 部署地址 (Vercel 上可留空, 路由会自动从请求头推导) ----------
# 本地开发留空即可, 服务端会从 request.headers 推导 origin
WEB_ORIGIN=""

# ---------- 支付 (默认 Mock, 不需任何凭据) ----------
# 取值: mock (默认) | alipay | wechatpay
PAYMENT_PROVIDER="mock"
# 真实支付异步通知地址 (Vercel 部署后填公网地址, 例: https://你的域名/api/payment/notify)
# PAYMENT_NOTIFY_URL=""

# 支付宝 (需企业/个体商户资质 + npm i alipay-sdk 后取消 TODO 实现)
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# 微信支付 V3 (需企业商户号 + npm i wechatpay-node-v3 后取消 TODO 实现)
WECHATPAY_MCH_ID=""
WECHATPAY_API_V3_KEY=""
WECHATPAY_CERT_SERIAL=""
WECHATPAY_PRIVATE_KEY_PATH=""

# ---------- 聚合登录 (推荐, 一对凭据接入 QQ/微信/微博/支付宝/百度/抖音/华为/小米/GitHub/Google 等) ----------
# 注册地址: https://www.juhedenglu.cn  (免费试用版 50 用户)
# 配置后前端 "第三方快捷登录" 按钮即可用, 无需再单独配置各平台
JUHE_APP_ID=""
JUHE_APP_KEY=""

# ---------- 各平台直连 (可选, 未配聚合登录时使用直连; 不配则该渠道 503) ----------
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 微信开放平台: https://open.weixin.qq.com (网站应用需审核)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# QQ 互联: https://connect.qq.com
QQ_APP_ID=""
QQ_APP_KEY=""
# 微博开放平台: https://open.weibo.com
WEIBO_APP_KEY=""
WEIBO_APP_SECRET=""

# ---------- 前端 (默认同源, 留空即可) ----------
NEXT_PUBLIC_API_BASE=""

# ---------- AI 视觉识别 (实名认证审核辅助识图, 可选) ----------
# 支持 OpenAI / DeepSeek / 豆包 / 通义千问 等 OpenAI 兼容接口
# 未配置 AI_VISION_API_KEY 则管理后台「实名认证审核」仅支持纯人工审核
#
# 选择服务商 (设置后 base_url 和 model 会自动填充默认值, 也可手动覆盖):
#   openai    → OpenAI (gpt-4o-mini)
#   deepseek  → DeepSeek 视觉 (deepseek-vl2)
#   doubao    → 豆包 / 火山引擎方舟 (doubao-1-5-vision-pro-32k-250115)
#   qwen      → 通义千问视觉 (qwen-vl-max)
AI_VISION_PROVIDER="openai"
# 必填: 对应服务商的 API Key
AI_VISION_API_KEY=""
# 可选: 不填则按 AI_VISION_PROVIDER 自动使用默认值
# AI_VISION_BASE_URL=""
# AI_VISION_MODEL=""
