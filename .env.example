# =====================================================================
# 校园墙环境变量示例
# 本地开发: 复制为 .env.local
# Vercel 部署: 在 Vercel 项目 Settings → Environment Variables 逐个填入
# =====================================================================

# ---------- 数据库 (Supabase PostgreSQL, 必填) ----------
# Supabase 控制台获取: https://supabase.com → 项目 → Connect
# 免费托管 PG, 附带对象存储/认证等; 也可用 Neon / 自建 PG
#
# DATABASE_URL: 应用运行时连接串 (Transaction pooler, 端口 6543, 适合 serverless)
#   形如: postgresql://postgres.<项目ref>:<密码>@aws-0-<区域>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""
# DIRECT_URL: prisma db push / seed 用的直连串 (Session pooler, 端口 5432, 同账号密码)
#   形如: postgresql://postgres.<项目ref>:<密码>@aws-0-<区域>.pooler.supabase.com:5432/postgres
DIRECT_URL=""

# ---------- JWT (必填) ----------
# 任意长随机字符串, 建议 32+ 字符
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---------- 种子数据 (首次 db:seed 创建超级管理员) ----------
SEED_SUPER_ADMIN_EMAIL="admin@campus.edu"
SEED_SUPER_ADMIN_PASSWORD="Admin@12345"

# ---------- 部署地址 (Vercel 上可留空, 路由会自动从请求头推导) ----------
# 本地开发留空即可, 服务端会从 request.headers 推导 origin
WEB_ORIGIN=""

# ---------- 支付 (默认 Mock, 不需任何凭据) ----------
# 取值: mock (默认) | alipay | wechatpay
PAYMENT_PROVIDER="mock"
# 真实支付异步通知地址 (Vercel 部署后填公网地址, 例: https://你的域名/api/payment/notify)
# PAYMENT_NOTIFY_URL=""

# 支付宝 (需企业/个体商户资质 + npm i alipay-sdk 后取消 TODO 实现)
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"

# 微信支付 V3 (需企业商户号 + npm i wechatpay-node-v3 后取消 TODO 实现)
WECHATPAY_MCH_ID=""
WECHATPAY_API_V3_KEY=""
WECHATPAY_CERT_SERIAL=""
WECHATPAY_PRIVATE_KEY_PATH=""

# ---------- 聚合登录 (推荐, 一对凭据接入 QQ/微信/微博/支付宝/百度/抖音/华为/小米/GitHub/Google 等) ----------
# 注册地址: https://www.juhedenglu.cn  (免费试用版 50 用户)
# 配置后前端 "第三方快捷登录" 按钮即可用, 无需再单独配置各平台
JUHE_APP_ID=""
JUHE_APP_KEY=""

# ---------- 各平台直连 (可选, 未配聚合登录时使用直连; 不配则该渠道 503) ----------
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 微信开放平台: https://open.weixin.qq.com (网站应用需审核)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# QQ 互联: https://connect.qq.com
QQ_APP_ID=""
QQ_APP_KEY=""
# 微博开放平台: https://open.weibo.com
WEIBO_APP_KEY=""
WEIBO_APP_SECRET=""

# ---------- 前端 (默认同源, 留空即可) ----------
NEXT_PUBLIC_API_BASE=""

# ---------- 实名认证 OCR 识别 (审核辅助识图, 可选) ----------
# 文字提取优先使用专用 OCR 服务 (比视觉大模型识字更准), 支持以下 Provider:
#   ocrspace  → OcrSpace 免费 OCR (中文支持, 免费额度 25000 次/月, 推荐先用这个)
#               申请地址: https://ocr.space/ocrapi/freekey
#   baidu     → 百度 OCR (中文识别更准, 需企业/个人开发者账号)
#               申请地址: https://ai.baidu.com/tech/ocr/general
#   vision    → OpenAI 兼容视觉大模型 (仅做图片质量判断, 不做主要文字提取)
#
# 通过 OCR_PROVIDER 显式选择; 不配则按 ocrspace > baidu > vision 顺序自动选用。
# 未配置任何 Provider 则管理后台「实名认证审核」仅支持纯人工审核。
OCR_PROVIDER=""

# --- OcrSpace (免费, 推荐) ---
OCR_SPACE_API_KEY=""
# OCR_SPACE_ENDPOINT=""  # 留空用默认 https://api.ocr.space/parse/image

# --- 百度 OCR ---
BAIDU_OCR_API_KEY=""
BAIDU_OCR_SECRET_KEY=""

# --- 视觉大模型 (可选, 仅用于判断是否校园卡/是否清晰) ---
# 支持 OpenAI / DeepSeek / 豆包 / 通义千问 等 OpenAI 兼容接口
#   openai    → OpenAI (gpt-4o-mini)
#   deepseek  → DeepSeek 视觉 (deepseek-vl2)
#   doubao    → 豆包 / 火山引擎方舟 (doubao-1-5-vision-pro-32k-250115)
#   qwen      → 通义千问视觉 (qwen-vl-max)
AI_VISION_PROVIDER="openai"
AI_VISION_API_KEY=""
# AI_VISION_BASE_URL=""
# AI_VISION_MODEL=""
